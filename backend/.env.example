# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# URL of the frontend (used for CORS and Stripe redirect URLs)
CLIENT_URL=http://localhost:5173

# ─── Database ─────────────────────────────────────────────────────────────────
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce-template
# MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# ─── Default Admin User (created on first startup if it doesn't exist) ────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# ─── Cloudinary (image uploads) ───────────────────────────────────────────────
# Sign up at https://cloudinary.com — free tier is enough for most stores
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Stripe (online payments) — OPTIONAL ──────────────────────────────────────
# Leave blank to disable the Stripe payment option.
# Get keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Webhook secret — get it after adding an endpoint pointing to:
# https://yourdomain.com/api/v1/stripe/webhook
# Events to listen: checkout.session.completed
STRIPE_WEBHOOK_SECRET=

# ─── Email notifications — OPTIONAL ───────────────────────────────────────────
# Leave blank to disable order notification emails.
# Example for Gmail: use an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="My Store <your@gmail.com>"
# Email address that receives order notifications (defaults to SMTP_USER if blank)
STORE_NOTIFICATION_EMAIL=
